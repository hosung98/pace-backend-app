# 실제 값은 커밋하지 말고 서버 환경 변수 또는 Kubernetes Secret으로 주입합니다.
SPRING_PROFILES_ACTIVE=dev
DB_URL=jdbc:postgresql://localhost:5432/pace_dev
DB_USERNAME=pace_dev_user
DB_PASSWORD=replace-with-database-password
# openssl rand -base64 32 로 생성한 값을 입력합니다.
JWT_SECRET=replace-with-base64-random-key
# 쉼표로 구분한 Google OAuth 클라이언트 ID입니다.
GOOGLE_CLIENT_IDS=replace-with-client-id.apps.googleusercontent.com
APPLE_CLIENT_IDS=com.hocompany.pace
APPLE_CLIENT_ID=com.hocompany.pace
# Apple ES256 client secret JWT를 Secret Manager에서 주입하고 만료 전에 교체합니다.
APPLE_CLIENT_SECRET=
SWAGGER_ENABLED=false
CORS_ORIGINS=https://your-frontend.example.com
