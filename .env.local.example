# 로컬 실행 예시 파일입니다. 실제 비밀값은 .env.local에 넣고 커밋하지 마세요.
SPRING_PROFILES_ACTIVE=local
DB_URL=jdbc:postgresql://localhost:5432/pace_dev
DB_USERNAME=pace_dev_user
DB_PASSWORD=replace-with-local-db-password

# local에서는 비워둘 수 있지만, 고정 토큰 테스트가 필요하면 값을 넣어 주세요.
JWT_SECRET=
GOOGLE_CLIENT_IDS=local-unconfigured
APPLE_CLIENT_IDS=com.hocompany.pace
APPLE_CLIENT_ID=com.hocompany.pace
APPLE_CLIENT_SECRET=
SWAGGER_ENABLED=true
CORS_ORIGINS=http://localhost:3000
